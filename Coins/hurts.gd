extends Area2D

func _on_body_entered(body: Node2D) -> void:
	if body.name == "Player":
		# Ищем Count_hearts на любой сцене
		var count_hearts = get_tree().root.find_child("Count_hearts", true, false)
		if count_hearts:
			count_hearts.add_score(1)
		
# Определяем, какой уровень загружен
		var current_level = get_tree().current_scene.name
		
		# Ищем CanvasLayer (универсально)
		var canvas = get_tree().current_scene.find_child("CanvasLayer", true, false)
		
		# Выбираем фразы в зависимости от уровня и имени сердечка
		match current_level:
			"Level1":
				match name:
					"Hearts1":
						canvas.show_message("Кто-то боялся, что его никто не услышит.\nТы забираешь этот страх. Теперь он может говорить.")
					"Hearts3":
						canvas.show_message("Здесь была чья-то потеря. Кто-то так и не сказал 'прощай'.\nТы забираешь эту боль. Его сердце больше не плачет")
					"Hearts5":
						canvas.show_message("Кто-то чувствовал себя невидимкой среди толпы.\nТы забираешь его одиночество. Теперь его замечают.")
					"Hearts7":
						canvas.show_message("Кто-то почти перестал верить, что заслуживает любви.\nТы забираешь отчаяние. Его сердце снова открыто.")
					"Hearts9":
						canvas.show_message("Кто-то кричал, но никто не обернулся.\nТы забираешь эту глухоту мира. Его голосо услышан.")
			
			"Level2":
				match name:
					"Hearts1":
						canvas.show_message("Кто-то давно не слышал доброго слова. \nТы забираешь его немоту — теперь он может плакать вслух.")
					"Hearts3":
						canvas.show_message("Кто-то думал, что его чувства — обуза для других.\nТы забираешь этот стыд. Теперь он знает, что имеет право на боль.")
					"Hearts5":
						canvas.show_message("Кто-то перестал мечтать, потому что мечты не сбывались.\nТы забираешь его усталость. Теперь он снова видит звёзды.")
					"Hearts7":
						canvas.show_message("Кто-то носил в себе чужую вину.\nТы забираешь это наказание. Теперь он может дышать.")
					"Hearts9":
						canvas.show_message("Кто-то боялся быть счастливым — вдруг это отнимут.\nТы забираешь этот холод. Теперь он позволяет себе тепло.")
			"Level1_1":
				match name:
					"Hearts1":
						canvas.show_message("Ты боялся, что недостоин света. Этот страх был твоим.")
					"Hearts3":
						canvas.show_message("Ты когда-то хотел сдаться. Но не сдался. Эта сила теперь с тобой.")
					"Hearts5":
						canvas.show_message("Ты думал, что никому не нужен. Этот холод был внутри тебя.")
					"Hearts7":
						canvas.show_message("Ты боялся стать обузой. Теперь ты знаешь — это неправда.")
					"Hearts9":
						canvas.show_message("Ты сомневался в каждом шаге. Но ты всё равно шёл. Это и есть свет.")
			"Level2_1":
				match name:
					"Hearts1":
						canvas.show_message("Ты боялся, что твоя боль — ничто по сравнению с болью других.\nТеперь ты знаешь: каждая слеза имеет значение.")
					"Hearts3":
						canvas.show_message("Ты уставал быть сильным. Ты хотел, чтобы кто-то сказал: «Отдохни».\nТеперь ты говоришь это себе сам.")
					"Hearts5":
						canvas.show_message("Ты думал, что свет — это для кого-то другого.\nНо он всегда был внутри. Просто ты боялся его зажечь.")
					"Hearts7":
						canvas.show_message("Ты винил себя за то, что не спас всех.\nНо ты спас тех, кто был рядом. Этого достаточно.")
					"Hearts9":
						canvas.show_message("Ты спрашивал: «Кто я без чужой боли?\nОтвет: ты — тот, кто умеет любить. Даже когда больно.")
		queue_free()
