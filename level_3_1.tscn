[sub_resource type="TileSet" id="TileSet_coo4d"]
physics_layer_0/collision_layer = 1
sources/0 = SubResource("TileSetAtlasSource_7mece")

[sub_resource type="GDScript" id="GDScript_i4jdf"]
script/source = "extends Label

var score = 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	text = \"Сердца теней: 0\"

# Функция для увеличения счёта (будем вызывать из сердечка)
func add_score(value: int):
	score += value
	text = \"Сердца теней: \" + str(score)
"

[sub_resource type="GDScript" id="GDScript_wp4fb"]
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text = \"HP: \" + str($\"../../Player\".health)
"

